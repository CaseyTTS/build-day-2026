# Default: built-in stand-in model, no key, no network. Nothing needs to be set.
MODEL_PROVIDER=standin

# Local model via Ollama (after: ollama pull <model>)
# MODEL_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# MODEL=<a model you pulled>

# OpenAI or any OpenAI-compatible API
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=<model name>

# Approval gate. Default deny: every "ask" is refused. Same as passing --approve (yes) or --approve-cli (cli).
# HARNESS_APPROVE=deny
