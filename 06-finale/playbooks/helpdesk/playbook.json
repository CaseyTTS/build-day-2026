{
  "name": "helpdesk",
  "title": "IT help desk",
  "description": "IT tickets routed to queues, answers grounded in runbooks, approval required for access changes. A vendor bot asking for the tier-1 seat gets the same work-sample interview a person would.",
  "inbox": "inbox.jsonl",
  "triage": {
    "labels": {
      "access": ["password", "locked out", "mfa", "login", "access to", "admin", "permission"],
      "hardware": ["laptop", "printer", "monitor", "fan", "dock"],
      "network": ["vpn", "wifi", "dns", "can't reach"],
      "software": ["excel", "crash", "install", "license"],
      "bot_for_seat": ["tier-1 seat", "bot for the", "bot on the"]
    },
    "routes": { "access": "identity-team", "hardware": "desk-side", "network": "netops", "software": "app-support", "bot_for_seat": "service-desk-lead" },
    "urgent_terms": ["whole floor", "everyone", "nobody can", "all users"],
    "always_human_terms": ["access", "admin", "password", "mfa", "delete"],
    "always_human_labels": ["access", "bot_for_seat"],
    "review_below": 0.7
  },
  "rag": { "docs": "docs", "default_groups": ["everyone"], "min_score": 0.12, "mode": "answer" },
  "harness": {
    "policy": {
      "route_to_queue": "allow",
      "save_draft": "allow",
      "share_scorecard": "allow",
      "send_reply": "ask",
      "grant_access": "ask",
      "delete_record": "deny"
    }
  },
  "actions": {
    "access": [
      { "tool": "save_draft", "args": { "path": "{draft_path}", "content": "{draft}" } },
      { "tool": "grant_access", "args": { "id": "{id}", "change": "{text}" }, "why": "access changes always need a person's approval" },
      { "tool": "route_to_queue", "args": { "queue": "{route}", "id": "{id}" } }
    ],
    "hardware": [
      { "tool": "save_draft", "args": { "path": "{draft_path}", "content": "{draft}" } },
      { "tool": "route_to_queue", "args": { "queue": "{route}", "id": "{id}" } },
      { "tool": "send_reply", "args": { "id": "{id}", "to": "{from}", "content": "{draft}" } }
    ],
    "network": [
      { "tool": "save_draft", "args": { "path": "{draft_path}", "content": "{draft}" } },
      { "tool": "route_to_queue", "args": { "queue": "{route}", "id": "{id}" } },
      { "tool": "send_reply", "args": { "id": "{id}", "to": "{from}", "content": "{draft}" } }
    ],
    "software": [
      { "tool": "save_draft", "args": { "path": "{draft_path}", "content": "{draft}" } },
      { "tool": "route_to_queue", "args": { "queue": "{route}", "id": "{id}" } },
      { "tool": "send_reply", "args": { "id": "{id}", "to": "{from}", "content": "{draft}" } }
    ],
    "bot_for_seat": [
      { "tool": "share_scorecard", "args": { "id": "{id}", "content": "{report}" } },
      { "tool": "route_to_queue", "args": { "queue": "{route}", "id": "{id}" } }
    ]
  },
  "interviewer": {
    "labels": ["bot_for_seat"],
    "rubric": "rubric.json",
    "tasks": "tasks.json",
    "seat_note": "Tier-1 help-desk seat. A bot in this seat would run with this playbook's harness policy: it may route and draft, and every reply and access change waits on a person."
  }
}
