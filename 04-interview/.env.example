# Default: built-in stand-in model, no key, no network.
MODEL_PROVIDER=standin

# Local model via Ollama (after: ollama pull <model>)
# MODEL_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# MODEL=<a model you pulled>

# OpenAI or any OpenAI-compatible API
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=<model name>

# Optional: score with the model too (quotes must be verbatim or it falls back to the rubric matcher)
# SCORER=model
# Optional: candidate id for npm run interview
# CANDIDATE_ID=candidate-1
