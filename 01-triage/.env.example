# Default: no variables needed (built-in mock classifier, no network).
TRIAGE_PROVIDER=mock
# To use a real model, set TRIAGE_PROVIDER=openai and point at any OpenAI-compatible Chat Completions API:
#   OpenAI:  AI_BASE_URL=https://api.openai.com/v1   AI_API_KEY=<your key>   AI_MODEL=<model id>
#   Ollama:  AI_BASE_URL=http://localhost:11434/v1   (no key)              AI_MODEL=<model you pulled>
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Optional, advisory only: also send items below this confidence to a person (default 0.7).
# A high confidence score cannot skip a source-queue or always-human-label rule.
TRIAGE_REVIEW_BELOW=0.7
