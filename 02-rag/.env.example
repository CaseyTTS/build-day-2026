# Default: no variables needed (built-in mock embeddings + extractive answer, no network).
RAG_PROVIDER=mock
# Real models: RAG_PROVIDER=openai plus any OpenAI-compatible API (/v1/embeddings and /v1/chat/completions):
#   OpenAI:  AI_BASE_URL=https://api.openai.com/v1   AI_API_KEY=<your key>
#   Ollama:  AI_BASE_URL=http://localhost:11434/v1   (no key)
AI_BASE_URL=
AI_MODEL=
AI_EMBED_MODEL=
AI_API_KEY=
# Optional. Minimum similarity before answering.
# If unset: 0.12 when RAG_PROVIDER=mock, 0.60 when RAG_PROVIDER=openai (real embeddings).
# Set this to tune for your embedding model; score scales differ.
# RAG_MIN_SCORE=0.60
