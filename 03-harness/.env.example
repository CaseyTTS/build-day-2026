# Default: no variables needed (fixed mock plan, every "ask" refused).
HARNESS_PLANNER=mock
# Set HARNESS_APPROVE to "cli" to approve writes yourself at the prompt
HARNESS_APPROVE=deny
# Real planner: HARNESS_PLANNER=openai plus any OpenAI-compatible Chat Completions API:
#   OpenAI:  AI_BASE_URL=https://api.openai.com/v1   AI_API_KEY=<your key>   AI_MODEL=<model id>
#   Ollama:  AI_BASE_URL=http://localhost:11434/v1   (no key)              AI_MODEL=<model you pulled>
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# HARNESS_SANDBOX=./workspace_demo
# HARNESS_LOG=audit.jsonl
