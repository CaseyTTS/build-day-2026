{
  "name": "build-anywhere-ts",
  "version": "1.0.0",
  "description": "A TypeScript starter that runs the same in a home lab container, a Dev Container, or Codespaces.",
  "license": "MIT",
  "author": "CornerStone AI Research Lab",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/index.js",
    "check": "npm run lint && npm test",
    "demo": "npm run build && node dist/src/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0"
  }
}
